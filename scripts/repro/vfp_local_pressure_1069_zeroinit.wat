;; #1069 x #1594 (RQ-89-GARBAGE1069) -- the ONE-BRANCH-WRITTEN float-local
;; shape on the #1069 `vfp-frame-locals` rung, so the #1069 oracle's GARBAGE
;; stack / register modes reach the uninitialised-read class the zeroed-only
;; run was blind to. Each export is (param $a T) (param $c i32) (result T):
;; 14 pressure locals plus a probe local written on SOME path only
;; (`p_cond`: `if`, `p_brif`: `br_if` skip), read at the join. WebAssembly
;; zero-initialises the probe; a frame home born at its first `local.set`
;; reads stack garbage on the unwritten path. Bodies are the #1594 fixtures'
;; (float_local_zero_init_1594{,_f64}.wat) verbatim, so this file adds no new
;; shape of its own: it re-seats two of them under THIS oracle.
(module
  (func $p_cond (export "p_cond") (param $a f32) (param $c i32) (result f32)
    (local f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32)
    (local $i i32)
    (local.set 2 (f32.mul (local.get 0) (f32.const 1.5)))
    (local.set 3 (f32.mul (local.get 0) (f32.const 2.5)))
    (local.set 4 (f32.mul (local.get 0) (f32.const 3.5)))
    (local.set 5 (f32.mul (local.get 0) (f32.const 4.5)))
    (local.set 6 (f32.mul (local.get 0) (f32.const 5.5)))
    (local.set 7 (f32.mul (local.get 0) (f32.const 6.5)))
    (local.set 8 (f32.mul (local.get 0) (f32.const 7.5)))
    (local.set 9 (f32.mul (local.get 0) (f32.const 8.5)))
    (local.set 10 (f32.mul (local.get 0) (f32.const 9.5)))
    (local.set 11 (f32.mul (local.get 0) (f32.const 10.5)))
    (local.set 12 (f32.mul (local.get 0) (f32.const 11.5)))
    (local.set 13 (f32.mul (local.get 0) (f32.const 12.5)))
    (local.set 14 (f32.mul (local.get 0) (f32.const 13.5)))
    (local.set 15 (f32.mul (local.get 0) (f32.const 14.5)))
    (if (local.get $c) (then (local.set 16 (f32.mul (local.get 0) (f32.const 0.25)))))
    (f32.add (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (local.get 2) (local.get 3)) (local.get 4)) (local.get 5)) (local.get 6)) (local.get 7)) (local.get 8)) (local.get 9)) (local.get 10)) (local.get 11)) (local.get 12)) (local.get 13)) (local.get 14)) (local.get 15)) (local.get 16))
  )
  (func $p_brif (export "p_brif") (param $a f32) (param $c i32) (result f32)
    (local f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32 f32)
    (local $i i32)
    (local.set 2 (f32.mul (local.get 0) (f32.const 1.5)))
    (local.set 3 (f32.mul (local.get 0) (f32.const 2.5)))
    (local.set 4 (f32.mul (local.get 0) (f32.const 3.5)))
    (local.set 5 (f32.mul (local.get 0) (f32.const 4.5)))
    (local.set 6 (f32.mul (local.get 0) (f32.const 5.5)))
    (local.set 7 (f32.mul (local.get 0) (f32.const 6.5)))
    (local.set 8 (f32.mul (local.get 0) (f32.const 7.5)))
    (local.set 9 (f32.mul (local.get 0) (f32.const 8.5)))
    (local.set 10 (f32.mul (local.get 0) (f32.const 9.5)))
    (local.set 11 (f32.mul (local.get 0) (f32.const 10.5)))
    (local.set 12 (f32.mul (local.get 0) (f32.const 11.5)))
    (local.set 13 (f32.mul (local.get 0) (f32.const 12.5)))
    (local.set 14 (f32.mul (local.get 0) (f32.const 13.5)))
    (local.set 15 (f32.mul (local.get 0) (f32.const 14.5)))
    (block (br_if 0 (i32.eqz (local.get $c))) (local.set 16 (f32.mul (local.get 0) (f32.const 0.25))))
    (f32.add (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (f32.mul (local.get 2) (local.get 3)) (local.get 4)) (local.get 5)) (local.get 6)) (local.get 7)) (local.get 8)) (local.get 9)) (local.get 10)) (local.get 11)) (local.get 12)) (local.get 13)) (local.get 14)) (local.get 15)) (local.get 16))
  )
  (func $d_cond (export "d_cond") (param $a f64) (param $c i32) (result f64)
    (local f64 f64 f64 f64 f64 f64 f64 f64 f64)
    (local $i i32)
    (local.set 2 (f64.mul (local.get 0) (f64.const 1.5)))
    (local.set 3 (f64.mul (local.get 0) (f64.const 2.5)))
    (local.set 4 (f64.mul (local.get 0) (f64.const 3.5)))
    (local.set 5 (f64.mul (local.get 0) (f64.const 4.5)))
    (local.set 6 (f64.mul (local.get 0) (f64.const 5.5)))
    (local.set 7 (f64.mul (local.get 0) (f64.const 6.5)))
    (local.set 8 (f64.mul (local.get 0) (f64.const 7.5)))
    (local.set 9 (f64.mul (local.get 0) (f64.const 8.5)))
    (if (local.get $c) (then (local.set 10 (f64.mul (local.get 0) (f64.const 0.25)))))
    (f64.add (f64.mul (f64.mul (f64.mul (f64.mul (f64.mul (f64.mul (f64.mul (local.get 2) (local.get 3)) (local.get 4)) (local.get 5)) (local.get 6)) (local.get 7)) (local.get 8)) (local.get 9)) (local.get 10))
  )
)
